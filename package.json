{
  "name": "agent-casebook",
  "version": "0.1.0",
  "description": "A casebook of broken AI agents: recorded traces, six-suspect line-ups, sealed solutions and a detector per case.",
  "license": "MIT",
  "author": "Claire Donald",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "bin": {
    "casebook": "dist/src/cli/index.js"
  },
  "scripts": {
    "casebook": "node --import tsx src/cli/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "evals": "node --import tsx evals/run.ts",
    "record": "node --import tsx rigs/record.ts",
    "probe": "node --import tsx rigs/probe.ts",
    "check:terms": "node --import tsx scripts/check-terms.ts",
    "check:paths": "node --import tsx scripts/check-terms.ts --paths-only",
    "check:recordings": "node --import tsx scripts/check-recordings.ts",
    "seal": "node --import tsx scripts/seal.ts",
    "unseal": "node --import tsx scripts/unseal.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.20.5",
    "eslint": "^10.12.0",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vitest": "^4.1.11"
  }
}
